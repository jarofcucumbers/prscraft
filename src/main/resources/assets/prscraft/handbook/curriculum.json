  "lessons": [
    {
      "id": "intro",
      "diagram": "chain",
      "formulas": [
        "information → signal → channel → receiver",
        "one change at a time → compare captures"
      ]
    },
    {
      "id": "what_signal",
      "diagram": "sine",
      "formulas": [
        "x(t): amplitude at time t",
        "x(t) = A sin(2πft)",
        "A = 1; f = 10 Hz"
      ]
    },
    {
      "id": "time_frequency",
      "diagram": "sine",
      "formulas": [
        "T = 1 / f",
        "10 Hz → 0.1 s; 20 Hz → 0.05 s",
        "f_waveform [Hz] ≠ RF carrier [MHz]"
      ]
    },
    {
      "id": "read_spectrum",
      "diagram": "spectrum",
      "formulas": [
        "waveform: amplitude vs time",
        "spectrum: amplitude vs frequency",
        "10 Hz + 20 Hz → two spectral peaks"
      ]
    },
    {
      "id": "lab_tone",
      "diagram": "sine",
      "formulas": [
        "TX: analog; sin(10); RF = 100 MHz",
        "RX: RF = 100 MHz; thermal OFF; μ = variance = 0",
        "compare sin(10), 2*sin(10), sin(20)"
      ]
    },
    {
      "id": "lab_sum",
      "diagram": "spectrum",
      "formulas": [
        "x(t) = sin(10) + 0.5*cos(20)",
        "four tones: sin(10)+cos(20)+sin(30)+cos(40)",
        "LPF: pass 0…20 Hz"
      ]
    },
    {
      "id": "lab_adc",
      "diagram": "sampling",
      "formulas": [
        "sin(10): choose fvz = 100 Hz",
        "sampled: compare I vs II at duty = 0.5",
        "quantized: compare L = 4, 16, 256"
      ]
    }
  ],
  "components": [
    {
      "id": "tx",
      "items": [
        "transmitter"
      ],
      "diagram": "sine",
      "formulas": [
        "analog / sampled / quantized / bits / discrete",
        "RF: 1…10000 MHz; Ptx: −30…40 dBm"
      ]
    },
    {
      "id": "rx",
      "items": [],
      "diagram": "awgn",
      "formulas": [
        "y = attenuated input + μ + σZ",
        "UNRZ / URZ threshold = expected A_RX / 2"
      ]
    },
    {
      "id": "bit_generator",
      "items": [
        "bit_generator"
      ],
      "diagram": "bits",
      "formulas": [
        "P(1) = p; P(0) = 1−p",
        "NRZ / UNRZ / URZ; Rb = 1…1000 bit/s"
      ]
    },
    {
      "id": "amplifier",
      "items": [
        "amplifier"
      ],
      "diagram": "sine",
      "formulas": [
        "gain = 10^(GdB/20)",
        "G: −40…60 dB; output clipped at ±16 u"
      ]
    },
    {
      "id": "frequency_filter",
      "items": [
        "frequency_filter"
      ],
      "diagram": "spectrum",
      "formulas": [
        "pass low ≤ f ≤ high; 0 ≤ low < high ≤ 20000 Hz",
        "FFT bin frequency = k / capture duration"
      ]
    },
    {
      "id": "modulator",
      "items": [
        "modulator"
      ],
      "diagram": "bpsk",
      "formulas": [
        "AM: (1+m·x/peak) cos(2πfc t)",
        "BPSK: b(t) cos(2πfc t); 2 ≤ fc/Rb ≤ 16"
      ]
    },
    {
      "id": "adder",
      "items": [
        "adder"
      ],
      "diagram": "math",
      "formulas": [
        "y = gA·A + gB·B",
        "−10 ≤ gA,gB ≤ 10"
      ]
    },
    {
      "id": "integrator",
      "items": [
        "integrator"
      ],
      "diagram": "math",
      "formulas": [
        "y(t) = integral from 0 to min(t,T) of x(s) ds",
        "T: 0…8 s; u → u·s"
      ]
    },
    {
      "id": "correlator",
      "items": [
        "correlator"
      ],
      "diagram": "correlation",
      "formulas": [
        "R_AB(τ) = integral A(t) B(t+τ) dt",
        "normalized correlation: −1 ≤ ρ ≤ 1"
      ]
    },
    {
      "id": "time_gate",
      "items": [
        "time_gate"
      ],
      "diagram": "gate",
      "formulas": [
        "hold: pass for t ≥ T",
        "pulse: pass for T ≤ t < T+width"
      ]
    },
    {
      "id": "delay_line",
      "items": [
        "delay_line"
      ],
      "diagram": "gate",
      "formulas": [
        "y(t) = x(t−D); D: 0…8 s",
        "outside capture: zero; fractional interpolation"
      ]
    },
    {
      "id": "gray_converter",
      "items": [
        "gray_converter"
      ],
      "diagram": "gray",
      "formulas": [
        "g = b XOR (b >> 1)",
        "level index = round((x−min)·(L−1)/(max−min))"
      ]
